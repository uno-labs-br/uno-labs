# Cabeçalhos HTTP dos arquivos estáticos (Cloudflare Workers Static Assets e Cloudflare Pages).
# Não se aplicam às respostas do Worker (/api/contato), que define os próprios cabeçalhos.
# Em hospedagem tradicional (Apache/HostGator), o equivalente está em hospedagem-tradicional/.htaccess.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=2592000

/assets/img/*
  Cache-Control: public, max-age=2592000

/assets/css/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/assets/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
