---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página não encontrada | UNO Labs" noindex>
<header class="topo">
  <div class="container topo__in">
    <a class="topo__marca" href="/"><img src="/assets/img/uno-labs-horizontal-principal.svg" alt="UNO Labs, início" width="187" height="52"></a>
  </div>
</header>
<main class="pagina hero" style="min-height:calc(100vh - var(--topo))">
  <div class="container">
    <div class="texto">
      <p class="rotulo mono">Erro 404</p>
      <h1>Esta página não existe ou mudou de lugar.</h1>
      <p>O endereço pode ter sido digitado errado ou o conteúdo foi movido.</p>
      <p style="margin-top:32px;display:flex;flex-wrap:wrap;gap:16px 28px;align-items:center">
        <a class="btn btn--escuro" href="/">Ir para o início</a>{' '}
        <a class="link-sublinhado" href="/#contato">Falar com a gente</a>
        <button type="button" class="btn-preferencias-cookies" data-abrir-cookies>Preferências de cookies</button>
      </p>
    </div>
  </div>
</main>
</BaseLayout>
