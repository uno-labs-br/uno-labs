---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { canonicalURL, site } from '../../data/site';

const description = 'E-mail marketing gerenciado pela Uno: a gente monta e cuida, e quem pediu orçamento e não fechou volta a conversar com você. Por mensalidade, para todo o Brasil.';
// Todo contato desta página acontece no WhatsApp, com a mensagem inicial já preenchida.
const whatsappEmail = `${site.whatsapp}?text=${encodeURIComponent('Olá! Quero saber mais sobre o E-mail marketing gerenciado.')}`;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'E-mail marketing gerenciado',
  serviceType: 'Automação e gestão de e-mail marketing',
  url: canonicalURL('/email-marketing/'),
  description,
  provider: {
    '@type': 'Organization',
    name: 'UNO Labs',
    url: 'https://unolabs.com.br/',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Brasil',
  },
};
const structuredData = JSON.stringify(serviceSchema).replace(/</g, '\\u003c');
---
<BaseLayout
  title="E-mail marketing gerenciado para empresas | UNO Labs"
  description={description}
  path="/email-marketing/"
  social
  imageAlt="UNO Labs: E-mail marketing gerenciado para empresas."
>
  <script slot="head" is:inline type="application/ld+json" set:html={structuredData} />
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo" class="email-conteudo">
    <section class="email-hero" aria-labelledby="email-titulo">
      <div class="container email-hero__grade">
        <div>
          <p class="email-hero__rotulo">E-mail marketing gerenciado · Todo o Brasil</p>
          <h1 id="email-titulo">Quem pediu orçamento e não fechou <em>volta a falar com você.</em></h1>
          <p class="email-lead">A Uno monta e cuida do e-mail marketing da sua empresa por uma mensalidade. Cada contato recebe a mensagem certa no tempo certo, e seu vendedor só liga para quem voltou a se interessar.</p>
          <div class="email-acoes">
            <a class="btn btn--uno-mint" href={whatsappEmail} target="_blank" rel="noopener" data-contact-channel="whatsapp" data-cta-id="whatsapp_email_hero" data-cta-position="email_hero">Falar no WhatsApp <svg class="seta" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <a class="btn email-btn-claro" href="#exemplo">Ver um exemplo</a>
          </div>
          <dl class="email-fatos">
            <div><dt>Quem faz</dt><dd>a Uno monta e opera</dd></div>
            <div><dt>Indicado para</dt><dd>quem já tem contatos parados</dd></div>
            <div><dt>Investimento</dt><dd>sob consulta</dd></div>
          </dl>
        </div>

        <figure class="email-caixa" aria-labelledby="email-caixa-legenda">
          <div class="email-caixa__lista">
            <p class="email-caixa__topo"><span>Caixa de entrada da Ana</span><span class="email-caixa__nota">exemplo ilustrativo</span></p>
            <ol>
              <li class="email-msg"><span class="email-dia">Dia 0</span><span class="email-msg__txt"><strong>Seu projeto de cozinha chegou</strong><span>Obrigado pelo orçamento, Ana. O projeto está aqui.</span></span><span class="email-msg__status">abriu</span></li>
              <li class="email-msg"><span class="email-dia">Dia 7</span><span class="email-msg__txt"><strong>3 cozinhas parecidas com a sua</strong><span>Projetos do mesmo tamanho, entregues este ano.</span></span><span class="email-msg__status">clicou</span></li>
              <li class="email-msg email-msg--agora"><span class="email-dia">Dia 21</span><span class="email-msg__txt"><strong>Condição especial para fechar este mês</strong><span>Revise o projeto com o vendedor, sem compromisso.</span></span><span class="email-msg__status">agora</span></li>
            </ol>
          </div>
          <div class="email-aberto" aria-hidden="true">
            <div class="email-aberto__img"><span>Cozinha planejada · seu projeto</span></div>
            <div class="email-aberto__corpo">
              <p>Oi, Ana. Seu projeto continua guardado. Neste mês temos uma condição especial para quem fecha.</p>
              <span class="email-aberto__botao">Ver condições</span>
            </div>
          </div>
          <p class="email-alerta"><strong>Aviso para o vendedor</strong>Ana clicou em “Ver condições”. Hoje é um bom dia para ligar.</p>
          <figcaption id="email-caixa-legenda" class="sr">Exemplo ilustrativo: a Ana pediu orçamento de uma cozinha e recebeu três e-mails automáticos, nos dias 0, 7 e 21. Quando ela clicou nas condições, o vendedor foi avisado.</figcaption>
        </figure>
      </div>
    </section>

    <section class="email-comparar" id="exemplo" aria-labelledby="exemplo-titulo">
      <div class="container">
        <p class="rotulo">Exemplo</p>
        <h2 id="exemplo-titulo">O mesmo orçamento, nos 30 dias seguintes.</h2>
        <div class="email-linhas" data-foco="com">
          <div class="email-linhas__cab">
            <p class="email-linhas__titulo">O orçamento da Ana, cozinha planejada</p>
            <div class="email-alternar" role="group" aria-label="Destacar cenário">
              <button type="button" data-cenario="sem" aria-pressed="false">Sem a Uno</button>
              <button type="button" data-cenario="com" aria-pressed="true">Com a Uno</button>
            </div>
          </div>
          <div class="email-linha email-linha--sem">
            <h3>Sem a Uno</h3>
            <ol>
              <li><span class="email-linha__dia">Dia 0</span><strong>Orçamento enviado</strong><span>PDF pelo WhatsApp.</span></li>
              <li class="email-linha__vazio"><span class="email-linha__dia">Dia 3</span><span>Silêncio.</span></li>
              <li class="email-linha__vazio"><span class="email-linha__dia">Dia 7</span><span>Silêncio.</span></li>
              <li class="email-linha__vazio"><span class="email-linha__dia">Dia 21</span><span>O vendedor esquece.</span></li>
              <li><span class="email-linha__dia">Dia 30</span><strong>Fechou com outra loja</strong></li>
            </ol>
          </div>
          <div class="email-linha email-linha--com">
            <h3>Com a Uno</h3>
            <ol>
              <li><span class="email-linha__dia">Dia 0</span><strong>Projeto por e-mail</strong><span>Abriu.</span></li>
              <li><span class="email-linha__dia">Dia 3</span><strong>Dicas de acabamento</strong><span>Abriu.</span></li>
              <li><span class="email-linha__dia">Dia 7</span><strong>3 cozinhas parecidas</strong><span>Clicou.</span></li>
              <li><span class="email-linha__dia">Dia 21</span><strong>Condição do mês</strong><span>Clicou em condições.</span></li>
              <li class="email-linha__fim"><span class="email-linha__dia">Dia 21</span><strong>Vendedor avisado</strong><span>“Ana voltou. Ligar hoje.”</span></li>
            </ol>
          </div>
        </div>
        <p class="email-comparar__nota">Exemplo ilustrativo. Cada empresa tem sua sequência, montada com a Uno e aprovada por você.</p>
      </div>
    </section>

    <section class="email-bloco email-bloco--tom" id="entrega" aria-labelledby="entrega-titulo">
      <div class="container">
        <p class="rotulo">Entrega</p>
        <h2 id="entrega-titulo">O que a Uno entrega</h2>
        <ul class="email-entrega">
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18" stroke="currentColor" stroke-width="1.6"/></svg>
            <h3>Ferramenta só sua</h3>
            <p>Seus contatos ficam numa ferramenta exclusiva da sua empresa, que a Uno instala e mantém.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>Contatos organizados</h3>
            <p>Importamos e limpamos a lista e separamos por interesse. Todo e-mail tem opção de descadastro.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="19" cy="6" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="19" cy="18" r="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 11l10-4M7 13l10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>Mensagens automáticas</h3>
            <p>Cada pessoa recebe o próximo e-mail conforme o que fez com o anterior, sem envio manual.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
            <h3>Aviso de quem está interessado</h3>
            <p>Quem abre e clica mais ganha destaque, e sua equipe é avisada na hora certa de ligar.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <h3>Envio configurado</h3>
            <p>Configuramos o domínio de envio e acompanhamos rejeições e reclamações para manter a entrega saudável.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M21 20H3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>Relatório mensal</h3>
            <p>Quantos abriram, clicaram e voltaram a conversar, e quais contatos passaram para o comercial.</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="email-bloco" aria-labelledby="passos-titulo">
      <div class="container">
        <p class="rotulo">Como funciona</p>
        <h2 id="passos-titulo">Do contato parado às mensagens no ar em 3 passos.</h2>
        <ol class="email-passos">
          <li class="email-passo">
            <span class="email-passo__num" aria-hidden="true">01</span>
            <h3>Conversa inicial</h3>
            <p>Entendemos quantos contatos você tem, de onde vieram, quantos e-mails quer enviar e o que sua equipe precisa receber.</p>
          </li>
          <li class="email-passo">
            <span class="email-passo__num" aria-hidden="true">02</span>
            <h3>Implantação pela Uno</h3>
            <p>Instalamos a ferramenta, configuramos o domínio, importamos os contatos e montamos as primeiras mensagens automáticas.</p>
          </li>
          <li class="email-passo">
            <span class="email-passo__num" aria-hidden="true">03</span>
            <h3>Operação mensal</h3>
            <p>Acompanhamos os envios, ajustamos as mensagens e enviamos o relatório. Você aprova o conteúdo.</p>
          </li>
        </ol>

        <div class="email-divisao">
          <div>
            <h3>Sua parte</h3>
            <ul class="email-itens">
              <li>Fornecer a base de contatos que consentiram em receber.</li>
              <li>Aprovar o conteúdo e as ofertas de cada campanha.</li>
              <li>Atender quem voltou a se interessar.</li>
            </ul>
          </div>
          <div>
            <h3>Fora deste serviço</h3>
            <ul class="email-itens">
              <li>Compra de listas ou envio para quem não autorizou.</li>
              <li>Garantia de chegada à caixa de entrada, que depende também dos provedores.</li>
              <li>Anúncios pagos e criação de site, que são pacotes à parte.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="email-bloco email-bloco--tom" aria-labelledby="publico-titulo">
      <div class="container">
        <p class="rotulo">Para quem</p>
        <h2 id="publico-titulo">Para empresas com contatos parados e pouco relacionamento com eles.</h2>
        <article class="email-destaque" aria-labelledby="moveis-titulo">
          <div class="email-destaque__texto">
            <p class="email-destaque__selo">Foco da Uno</p>
            <h3 id="moveis-titulo">Móveis planejados</h3>
            <p>Marcenarias, lojas e projetistas acumulam orçamentos que esfriaram. As mensagens automáticas devolvem esses contatos à conversa com inspiração, casos reais e condições, até o cliente estar pronto para fechar. Pode ser combinada com anúncios pagos, contratados à parte, para trazer novos contatos.</p>
          </div>
          <ul class="email-itens">
            <li>Orçamentos antigos retomados por ambiente: cozinha, quarto, closet.</li>
            <li>Aviso ao vendedor quando o cliente volta a se interessar.</li>
            <li>Relatório mensal de quem reabriu a conversa.</li>
          </ul>
        </article>
        <p class="email-publico__titulo">Também atendemos</p>
        <div class="email-publico">
          <div>
            <h3>Indústrias e distribuidores</h3>
            <p>Revendas e compradores recebem lançamentos e tabelas conforme o tipo de cliente, sem disparo genérico.</p>
          </div>
          <div>
            <h3>Escolas e cursos</h3>
            <p>Interessados de cada turma são nutridos até a matrícula, e ex-alunos recebem novas ofertas.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="duvidas" id="duvidas" aria-labelledby="duvidas-titulo">
      <div class="container duvidas__grade">
        <div class="duvidas__cab">
          <p class="rotulo">Dúvidas</p>
          <h2 class="titulo-medio" id="duvidas-titulo">Perguntas sobre o serviço.</h2>
          <p class="texto-apoio email-duvidas__apoio">Tem outra dúvida específica? <a href="#contato">Fale com a gente pelo WhatsApp</a>.</p>
        </div>
        <div class="faq">
          <details open><summary>Quanto custa?</summary><p>O valor depende do tamanho da base, do volume mensal de envios e do número de sequências de mensagens. Depois do diagnóstico, enviamos uma proposta com implantação e mensalidade fixas.</p></details>
          <details><summary>Consigo trazer os contatos da ferramenta que uso hoje?</summary><p>Sim. Importamos contatos, grupos e o histórico de descadastros, para ninguém que pediu para sair voltar a receber.</p></details>
          <details><summary>Os e-mails vão cair na caixa de entrada?</summary><p>Nenhum serviço consegue garantir isso, porque a decisão final é do provedor de quem recebe. Autenticamos o domínio, cuidamos da reputação de envio e acompanhamos rejeições e reclamações para manter a entrega saudável.</p></details>
          <details><summary>De quem são os contatos?</summary><p>Da sua empresa. A plataforma é exclusiva e você pode exportar a base quando quiser.</p></details>
          <details><summary>Posso enviar para uma lista comprada?</summary><p>Não. Enviamos só para quem consentiu em receber, como pede a LGPD. Listas compradas prejudicam a reputação do domínio e a entrega de todos os e-mails da empresa.</p></details>
        </div>
      </div>
    </section>

    <section class="email-contato" id="contato" aria-labelledby="contato-titulo">
      <div class="container email-contato__grade">
        <div>
          <p class="rotulo">Contato</p>
          <h2 id="contato-titulo">Vamos colocar sua base para trabalhar.</h2>
          <p>Chame a Uno no WhatsApp. Conte quantos contatos você tem, se usa alguma ferramenta hoje e o que quer automatizar. Respondemos com a proposta.</p>
        </div>
        <div class="email-contato__cartao">
          <p class="email-contato__rotulo">WhatsApp da Uno</p>
          <p class="email-contato__numero">(27) 93618-5141</p>
          <a class="btn btn--escuro" href={whatsappEmail} target="_blank" rel="noopener" data-contact-channel="whatsapp" data-cta-id="whatsapp_email_contato" data-cta-position="email_contato">Falar no WhatsApp <svg class="seta" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
<script>
  import '../../scripts/interno';
  import { aoDOMPronto } from '../../scripts/comum';

  function iniciarComparacao(): void {
    const linhas = document.querySelector<HTMLElement>('.email-linhas');
    if (!linhas) return;
    const botoes = linhas.querySelectorAll<HTMLButtonElement>('[data-cenario]');
    botoes.forEach((botao) => {
      botao.addEventListener('click', () => {
        linhas.dataset.foco = botao.dataset.cenario;
        botoes.forEach((outro) => outro.setAttribute('aria-pressed', String(outro === botao)));
      });
    });
    if (!('IntersectionObserver' in window)) {
      linhas.classList.add('is-visivel');
      return;
    }
    const observador = new IntersectionObserver((entradas) => {
      if (!entradas.some((entrada) => entrada.isIntersecting)) return;
      linhas.classList.add('is-visivel');
      observador.disconnect();
    }, { rootMargin: '0px 0px -15% 0px' });
    observador.observe(linhas);
  }

  aoDOMPronto(iniciarComparacao);
</script>
<style>
  .email-hero {
    position: relative;
    overflow: hidden;
    padding: clamp(40px, 5vw, 72px) 0 clamp(56px, 7vw, 104px);
    color: var(--uno-off-white);
    background:
      radial-gradient(900px 520px at 80% 25%, rgba(125, 211, 168, .2), transparent 62%),
      radial-gradient(700px 500px at 0% 100%, rgba(61, 170, 120, .16), transparent 60%),
      var(--uno-pine);
  }
  .email-hero__grade { display: grid; gap: 56px; align-items: center; }
  @media (min-width: 1000px) {
    .email-hero__grade { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 64px; }
  }
  .email-hero__rotulo { margin: 0 0 18px; font-size: 15px; font-weight: 600; color: var(--uno-mint); }
  h1 {
    font-size: clamp(38px, 4.6vw, 64px);
    line-height: 1.03;
    font-weight: 600;
    letter-spacing: -0.045em;
    color: var(--uno-off-white);
    text-wrap: balance;
  }
  h1 em { font-style: normal; color: var(--uno-mint); }
  .email-lead {
    max-width: 36rem;
    margin-top: 24px;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: rgba(243, 247, 243, .8);
    text-wrap: pretty;
  }
  .email-acoes { display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 32px; }
  .email-btn-claro { color: var(--uno-off-white); box-shadow: inset 0 0 0 1px rgba(243, 247, 243, .35); }
  .email-btn-claro:hover { color: var(--uno-off-white); background: rgba(243, 247, 243, .08); }
  .email-hero :focus-visible { outline-color: var(--uno-mint); }
  .email-fatos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 40px; }
  .email-fatos > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 18px;
    border-left: 1px solid var(--uno-line-dark);
  }
  .email-fatos > div:first-child { padding-left: 0; border-left: 0; }
  .email-fatos dt { font-size: 15px; font-weight: 600; color: var(--uno-mint); }
  .email-fatos dd { font-size: 15px; color: rgba(243, 247, 243, .78); }

  .email-caixa { position: relative; margin: 0; padding: 0 0 96px; }
  .email-caixa__lista {
    margin-right: clamp(0px, 4vw, 56px);
    padding: 20px;
    border-radius: var(--uno-radius-lg);
    background: rgba(255, 255, 255, .06);
    border: 1px solid var(--uno-line-dark);
  }
  @media (min-width: 600px) { .email-caixa__lista { padding-bottom: 180px; } }
  .email-caixa__topo { display: flex; justify-content: space-between; gap: 12px; font-size: 13px; color: rgba(243, 247, 243, .72); }
  .email-caixa__nota { font-family: var(--uno-font-mono); font-size: 12px; }
  .email-caixa ol { margin: 6px 0 0; padding: 0; list-style: none; }
  .email-msg {
    display: grid;
    grid-template-columns: 58px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: center;
    margin-top: 10px;
    padding: 14px 16px;
    border-radius: 16px;
    background: rgba(255, 255, 255, .07);
  }
  .email-msg__txt { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .email-msg__txt strong { font-size: 15px; font-weight: 600; }
  .email-msg__txt span { font-size: 13px; color: rgba(243, 247, 243, .66); }
  .email-msg__status { font-family: var(--uno-font-mono); font-size: 12px; color: var(--uno-mint); }
  .email-dia {
    padding: 6px 0;
    border-radius: 8px;
    background: var(--uno-mint);
    color: var(--uno-pine);
    font-family: var(--uno-font-mono);
    font-size: 11px;
    text-align: center;
    text-transform: uppercase;
  }
  .email-msg--agora { background: var(--uno-off-white); color: var(--uno-ink); box-shadow: 0 20px 50px rgba(0, 0, 0, .25); }
  .email-msg--agora .email-msg__txt span { color: var(--uno-ink-2); }
  .email-msg--agora .email-msg__status { color: var(--uno-mint-deep); }
  @media (min-width: 1000px) { .email-msg--agora { transform: translateX(24px); } }
  .email-aberto {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(330px, 78%);
    overflow: hidden;
    border-radius: 20px;
    background: var(--uno-white);
    color: var(--uno-ink);
    box-shadow: 0 40px 90px rgba(0, 0, 0, .35);
  }
  .email-aberto__img {
    display: flex;
    align-items: flex-end;
    height: 110px;
    padding: 12px 14px;
    background: linear-gradient(135deg, #D9C6A8, #A88A64);
    color: var(--uno-white);
    font-size: 13px;
    font-weight: 600;
