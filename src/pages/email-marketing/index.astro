---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { canonicalURL, site } from '../../data/site';

const description = 'E-mail marketing gerenciado para empresas com bases grandes: plataforma exclusiva, jornadas automáticas, pontuação de leads e relatórios. Foco em móveis planejados. A Uno estrutura e opera. Atendimento em todo o Brasil.';
// Todo contato desta página acontece no WhatsApp, com a mensagem inicial já preenchida.
const whatsappEmail = `${site.whatsapp}?text=${encodeURIComponent('Olá! Quero saber mais sobre o E-mail marketing gerenciado.')}`;
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'E-mail marketing gerenciado',
  serviceType: 'Automação e gestão de e-mail marketing',
  url: canonicalURL('/email-marketing/'),
  description,
  provider: {
    '@type': 'Organization',
    name: 'UNO Labs',
    url: 'https://unolabs.com.br/',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Brasil',
  },
};
const structuredData = JSON.stringify(serviceSchema).replace(/</g, '\\u003c');
---
<BaseLayout
  title="E-mail marketing gerenciado para empresas | UNO Labs"
  description={description}
  path="/email-marketing/"
  social
  imageAlt="UNO Labs: E-mail marketing gerenciado para empresas."
>
  <script slot="head" is:inline type="application/ld+json" set:html={structuredData} />
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo" class="email-conteudo">
    <section class="email-hero" aria-labelledby="email-titulo">
      <div class="container email-hero__grade">
        <div>
          <p class="rotulo">E-mail marketing gerenciado · Todo o Brasil</p>
          <h1 id="email-titulo">Sua base de contatos trabalhando todo mês.</h1>
          <p class="email-lead">A Uno estrutura e opera a automação de e-mail da sua empresa: listas, segmentos, jornadas e relatórios, numa plataforma exclusiva. Com foco em móveis planejados e em empresas com bases grandes que pagam caro por ferramentas cobradas por faixa de contatos.</p>
          <div class="email-acoes">
            <a class="btn btn--escuro" href={whatsappEmail} target="_blank" rel="noopener" data-contact-channel="whatsapp" data-cta-id="whatsapp_email_hero" data-cta-position="email_hero">Falar no WhatsApp <svg class="seta" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <a class="btn btn--contorno" href="#entrega">Ver o que entregamos</a>
          </div>
          <dl class="email-fatos">
            <div><dt>Plataforma</dt><dd>exclusiva da sua empresa</dd></div>
            <div><dt>Indicado para</dt><dd>bases a partir de 10 mil contatos</dd></div>
            <div><dt>Investimento</dt><dd>sob consulta</dd></div>
          </dl>
        </div>

        <figure class="email-jornada" aria-labelledby="email-jornada-legenda">
          <span class="email-jornada__badge">Exemplo: jornada de móveis planejados</span>
          <ol class="email-jornada__etapas">
            <li><strong>Pediu orçamento de uma cozinha</strong><span>Entra no segmento do ambiente e recebe o projeto por e-mail.</span></li>
            <li><strong>Não fechou na hora</strong><span>Semanas depois recebe casos e ambientes parecidos com o dele.</span></li>
            <li><strong>Clicou nas condições</strong><span>Ganha pontos e recebe o convite para rever o projeto com o vendedor.</span></li>
            <li class="email-jornada__fim"><strong>Lead quente</strong><span>Sua equipe é avisada com o histórico do contato.</span></li>
          </ol>
          <figcaption id="email-jornada-legenda">Ilustração: cada contato recebe a próxima mensagem conforme o que fez, sem envio manual.</figcaption>
        </figure>
      </div>
    </section>

    <section class="email-bloco email-bloco--linha" id="entrega" aria-labelledby="entrega-titulo">
      <div class="container">
        <p class="rotulo">Entrega</p>
        <h2 id="entrega-titulo">O que a Uno entrega</h2>
        <ul class="email-entrega">
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M3 9h18" stroke="currentColor" stroke-width="1.6"/></svg>
            <h3>Plataforma exclusiva</h3>
            <p>Uma instância só da sua empresa. Seus contatos não dividem espaço com outros clientes.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>Base organizada</h3>
            <p>Importação, limpeza e segmentos por interesse, origem e estágio, com descadastro em todo envio.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="5" cy="12" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="19" cy="6" r="2" stroke="currentColor" stroke-width="1.6"/><circle cx="19" cy="18" r="2" stroke="currentColor" stroke-width="1.6"/><path d="M7 11l10-4M7 13l10 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>Jornadas automáticas</h3>
            <p>Sequências que mudam conforme o que cada contato abre, clica ou visita.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
            <h3>Pontuação de leads</h3>
            <p>Os contatos mais engajados sobem de nível e o comercial é avisado na hora certa.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <h3>Domínio de envio autenticado</h3>
            <p>SPF, DKIM e DMARC configurados e acompanhamento de rejeições e reclamações.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M21 20H3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>Relatório mensal</h3>
            <p>Aberturas, cliques, descadastros e leads entregues ao comercial.</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="email-bloco" aria-labelledby="passos-titulo">
      <div class="container">
        <p class="rotulo">Como funciona</p>
        <h2 id="passos-titulo">Da base parada às campanhas no ar em 3 passos.</h2>
        <ol class="email-passos">
          <li class="email-passo">
            <span class="email-passo__num" aria-hidden="true">01</span>
            <h3>Diagnóstico da base</h3>
            <p>Entendemos o tamanho da base, a origem dos contatos, o volume de envios e o que sua equipe comercial precisa receber.</p>
          </li>
          <li class="email-passo">
            <span class="email-passo__num" aria-hidden="true">02</span>
            <h3>Implantação pela Uno</h3>
            <p>Subimos a plataforma, autenticamos o domínio, importamos os contatos e montamos as primeiras jornadas.</p>
          </li>
          <li class="email-passo">
            <span class="email-passo__num" aria-hidden="true">03</span>
            <h3>Operação mensal</h3>
            <p>Acompanhamos entregas, ajustamos segmentos e jornadas e enviamos o relatório. Você aprova o conteúdo.</p>
          </li>
        </ol>

        <div class="email-divisao">
          <div>
            <h3>Sua parte</h3>
            <ul class="email-itens">
              <li>Fornecer a base de contatos que consentiram em receber.</li>
              <li>Aprovar o conteúdo e as ofertas de cada campanha.</li>
              <li>Atender os leads quentes que a jornada entrega.</li>
            </ul>
          </div>
          <div>
            <h3>Fora deste serviço</h3>
            <ul class="email-itens">
              <li>Compra de listas ou envio para quem não autorizou.</li>
              <li>Garantia de chegada à caixa de entrada, que depende também dos provedores.</li>
              <li>Anúncios pagos e criação de site, que são pacotes à parte.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="email-bloco email-bloco--linha" aria-labelledby="publico-titulo">
      <div class="container">
        <p class="rotulo">Para quem</p>
        <h2 id="publico-titulo">Para empresas com muitos contatos e pouco relacionamento com eles.</h2>
        <article class="email-destaque" aria-labelledby="moveis-titulo">
          <div class="email-destaque__texto">
            <p class="email-destaque__selo">Foco da Uno</p>
            <h3 id="moveis-titulo">Móveis planejados</h3>
            <p>Marcenarias, lojas e projetistas acumulam orçamentos que esfriaram. A jornada devolve esses contatos à conversa com inspiração, casos reais e condições, até o cliente estar pronto para fechar. Pode ser combinada com anúncios pagos, contratados à parte, para trazer novos contatos.</p>
          </div>
          <ul class="email-itens">
            <li>Orçamentos antigos reativados por ambiente: cozinha, quarto, closet.</li>
            <li>Aviso ao vendedor quando o cliente volta a se interessar.</li>
            <li>Relatório mensal de quem reabriu a conversa.</li>
          </ul>
        </article>
        <p class="email-publico__titulo">Também atendemos</p>
        <div class="email-publico">
          <div>
            <h3>Indústrias e distribuidores</h3>
            <p>Revendas e compradores recebem lançamentos e tabelas por segmento, sem disparo genérico.</p>
          </div>
          <div>
            <h3>Escolas e cursos</h3>
            <p>Interessados de cada turma são nutridos até a matrícula, e ex-alunos recebem novas ofertas.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="duvidas" id="duvidas" aria-labelledby="duvidas-titulo">
      <div class="container duvidas__grade">
        <div class="duvidas__cab">
          <p class="rotulo">Dúvidas</p>
          <h2 class="titulo-medio" id="duvidas-titulo">Perguntas sobre o serviço.</h2>
          <p class="texto-apoio email-duvidas__apoio">Tem outra dúvida específica? <a href="#contato">Fale com a gente pelo WhatsApp</a>.</p>
        </div>
        <div class="faq">
          <details open><summary>Quanto custa?</summary><p>O valor depende do tamanho da base, do volume mensal de envios e do número de jornadas. Depois do diagnóstico, enviamos uma proposta com implantação e mensalidade fixas.</p></details>
          <details><summary>Consigo trazer os contatos da ferramenta que uso hoje?</summary><p>Sim. Importamos contatos, segmentos e o histórico de descadastros, para ninguém que pediu para sair voltar a receber.</p></details>
          <details><summary>Os e-mails vão cair na caixa de entrada?</summary><p>Nenhum serviço consegue garantir isso, porque a decisão final é do provedor de quem recebe. Autenticamos o domínio, cuidamos da reputação de envio e acompanhamos rejeições e reclamações para manter a entrega saudável.</p></details>
          <details><summary>De quem são os contatos?</summary><p>Da sua empresa. A plataforma é exclusiva e você pode exportar a base quando quiser.</p></details>
          <details><summary>Posso enviar para uma lista comprada?</summary><p>Não. Enviamos só para quem consentiu em receber, como pede a LGPD. Listas compradas prejudicam a reputação do domínio e a entrega de todos os e-mails da empresa.</p></details>
        </div>
      </div>
    </section>

    <section class="email-contato" id="contato" aria-labelledby="contato-titulo">
      <div class="container email-contato__grade">
        <div>
          <p class="rotulo">Contato</p>
          <h2 id="contato-titulo">Vamos colocar sua base para trabalhar.</h2>
          <p>Chame a Uno no WhatsApp. Conte o tamanho da base, a ferramenta que usa hoje e o que quer automatizar. Respondemos com a proposta.</p>
        </div>
        <div class="email-contato__cartao">
          <p class="email-contato__rotulo">WhatsApp da Uno</p>
          <p class="email-contato__numero">(27) 93618-5141</p>
          <a class="btn btn--escuro" href={whatsappEmail} target="_blank" rel="noopener" data-contact-channel="whatsapp" data-cta-id="whatsapp_email_contato" data-cta-position="email_contato">Falar no WhatsApp <svg class="seta" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
<script>
  import '../../scripts/interno';
</script>
<style>
  .email-hero {
    padding: clamp(32px, 4vw, 56px) 0 clamp(48px, 6vw, 80px);
    background-image:
      linear-gradient(rgba(16, 32, 28, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16, 32, 28, .045) 1px, transparent 1px);
    background-size: 80px 80px;
  }
  .email-hero__grade { display: grid; gap: 48px; align-items: start; }
  @media (min-width: 1000px) {
    .email-hero__grade { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 64px; }
  }
  h1 {
    font-size: clamp(38px, 4.6vw, 62px);
    line-height: 1.03;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--uno-pine);
    text-wrap: balance;
  }
  .email-lead {
    max-width: 40rem;
    margin-top: 24px;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--uno-ink-2);
    text-wrap: pretty;
  }
  .email-acoes { display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 32px; }
  .email-fatos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 40px; }
  .email-fatos > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 18px;
    border-left: 1px solid rgba(16, 32, 28, .15);
  }
  .email-fatos > div:first-child { padding-left: 0; border-left: 0; }
  .email-fatos dt { font-size: 16px; font-weight: 600; color: var(--uno-pine); }
  .email-fatos dd { font-size: 15px; color: var(--uno-ink-2); }

  .email-jornada {
    margin: 0;
    padding: clamp(20px, 3vw, 28px);
    border-radius: var(--uno-radius-lg);
    background: var(--uno-white);
    border: 1px solid var(--uno-line);
    box-shadow: 0 18px 48px rgba(18, 54, 45, .08);
  }
  .email-jornada__badge {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(14, 43, 36, .08);
    font-size: 12px;
    font-weight: 600;
    color: var(--uno-pine);
  }
  .email-jornada__etapas { margin: 20px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  .email-jornada__etapas li {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 0 20px 28px;
  }
  .email-jornada__etapas li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--uno-mint-deep);
    background: var(--uno-white);
  }
  .email-jornada__etapas li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 7px;
    top: 21px;
    bottom: 0;
    width: 2px;
    background: var(--uno-line);
  }
  .email-jornada__etapas li.email-jornada__fim { padding-bottom: 0; }
  .email-jornada__etapas li.email-jornada__fim::before { background: var(--uno-mint-deep); }
  .email-jornada__etapas strong { font-size: 15px; font-weight: 600; color: var(--uno-pine); }
  .email-jornada__etapas span { font-size: 14px; line-height: 1.5; color: var(--uno-ink-2); }
  .email-jornada figcaption {
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid var(--uno-line);
    font-size: 14px;
    line-height: 1.5;
    color: var(--uno-ink-2);
  }

  .email-bloco { padding: clamp(56px, 8vw, 96px) 0; }
  .email-bloco--linha { border-block: 1px solid var(--uno-line); }
  .email-bloco h2 {
    max-width: 26ch;
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--uno-pine);
    text-wrap: balance;
  }
  .email-bloco h3 { font-size: 19px; font-weight: 600; letter-spacing: -0.02em; color: var(--uno-pine); }
  .email-bloco p { font-size: 16px; line-height: 1.6; color: var(--uno-ink-2); }

  .email-entrega { display: grid; gap: 32px 40px; margin: 40px 0 0; padding: 0; list-style: none; }
  @media (min-width: 640px) { .email-entrega { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .email-entrega { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .email-entrega svg { color: var(--uno-mint-deep); }
  .email-entrega h3 { margin-top: 14px; }
  .email-entrega p { margin-top: 6px; }

  .email-passos { display: grid; gap: 16px; margin: 40px 0 0; padding: 0; list-style: none; }
  @media (min-width: 800px) { .email-passos { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; } }
  .email-passo {
    padding: 24px;
    border-radius: var(--uno-radius-md);
    background: var(--uno-white);
    border: 1px solid var(--uno-line);
  }
  .email-passo__num { font-size: 13px; font-weight: 600; color: var(--uno-mint-deep); font-family: var(--uno-font-mono); }
  .email-passo h3 { margin-top: 10px; }
  .email-passo p { margin-top: 8px; font-size: 15px; line-height: 1.55; }

  .email-divisao {
    display: grid;
    gap: 32px;
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--uno-line);
  }
  @media (min-width: 800px) { .email-divisao { grid-template-columns: 1fr 1fr; gap: 48px; } }
  .email-itens { margin: 16px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .email-itens li {
    display: flex;
    gap: 12px;
    align-items: baseline;
    font-size: 16px;
    line-height: 1.55;
    color: var(--uno-ink-2);
  }
  .email-itens li::before {
    content: '';
    flex: none;
    width: 12px;
    height: 2px;
    background: var(--uno-mint-deep);
    transform: translateY(-4px);
  }

  .email-destaque {
    display: grid;
    gap: 24px;
    margin-top: 36px;
    padding: clamp(24px, 3.5vw, 40px);
    border-radius: var(--uno-radius-lg);
    background: var(--uno-white);
    border: 1px solid var(--uno-line);
    border-left: 4px solid var(--uno-mint-deep);
    box-shadow: var(--uno-shadow);
  }
  @media (min-width: 900px) { .email-destaque { grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: center; } }
  .email-bloco .email-destaque__selo {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(14, 43, 36, .08);
    font-size: 12px;
    font-weight: 600;
    color: var(--uno-pine);
  }
  .email-destaque h3 { margin-top: 12px; font-size: clamp(24px, 2.6vw, 32px); }
  .email-destaque__texto > p:last-child { margin-top: 10px; }
  .email-destaque .email-itens { margin-top: 0; }
  .email-bloco .email-publico__titulo { margin-top: 40px; font-size: 14px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--uno-ink-2); }
  .email-publico { display: grid; gap: 28px; margin-top: 20px; }
  @media (min-width: 700px) { .email-publico { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; } }
  .email-publico > div { padding-left: 18px; border-left: 2px solid var(--uno-mint-deep); }
  .email-publico p { margin-top: 6px; }

  .duvidas { padding: clamp(56px, 7vw, 96px) 0; }
  .email-duvidas__apoio { margin-top: 24px; }
  .email-contato { padding: clamp(56px, 7vw, 96px) 0; background: var(--uno-off-white-2); }
  .email-contato__grade { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 900px) { .email-contato__grade { grid-template-columns: 1.2fr 1fr; gap: 64px; } }
  .email-contato h2 {
    max-width: 18ch;
    font-size: clamp(30px, 3.6vw, 48px);
    line-height: 1.06;
    font-weight: 600;
    letter-spacing: -0.03em;
    color: var(--uno-pine);
    text-wrap: balance;
  }
  .email-contato__grade > div:first-child > p:last-child { margin-top: 18px; max-width: 48ch; font-size: 17px; line-height: 1.6; color: var(--uno-ink-2); }
  .email-contato__cartao {
    padding: clamp(24px, 3.5vw, 40px);
    border-radius: var(--uno-radius-lg);
    background: var(--uno-white);
    border: 1px solid var(--uno-line);
    box-shadow: var(--uno-shadow);
  }
  .email-contato__rotulo { font-size: 15px; color: var(--uno-ink-2); }
  .email-contato__numero { margin-top: 4px; font-size: clamp(28px, 3vw, 36px); font-weight: 600; letter-spacing: -0.02em; color: var(--uno-pine); }
