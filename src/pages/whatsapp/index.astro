---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Contato from '../../components/home/Contato.astro';
import { canonicalURL, site } from '../../data/site';

const description = 'WhatsApp Business gerenciado no número da sua empresa, com qualquer DDD. Perfil comercial, respostas de horário e CRM com histórico. Atendimento em todo o Brasil. Planos a partir de R$ 147 por mês.';
const planos = [
  { nome: 'Essencial', implantacao: 297, mensalidade: 147 },
  { nome: 'Equipe', implantacao: 497, mensalidade: 247 },
];
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Canal WhatsApp gerenciado',
  serviceType: 'Gestão de canal de WhatsApp Business',
  url: canonicalURL('/whatsapp/'),
  description,
  provider: {
    '@type': 'Organization',
    name: 'UNO Labs',
    url: 'https://unolabs.com.br/',
  },
  areaServed: {
    '@type': 'Country',
    name: 'Brasil',
  },
  offers: planos.map((plano) => ({
    '@type': 'Offer',
    name: `Plano ${plano.nome}`,
    priceCurrency: 'BRL',
    priceSpecification: [
      {
        '@type': 'UnitPriceSpecification',
        name: 'Mensalidade',
        price: plano.mensalidade,
        priceCurrency: 'BRL',
        unitCode: 'MON',
      },
      {
        '@type': 'PriceSpecification',
        name: 'Implantação',
        price: plano.implantacao,
        priceCurrency: 'BRL',
      },
    ],
  })),
};
const structuredData = JSON.stringify(serviceSchema).replace(/</g, '\\u003c');
---
<BaseLayout
  title="Canal WhatsApp gerenciado para empresas | UNO Labs"
  description={description}
  path="/whatsapp/"
  social
  imageAlt="UNO Labs: Canal WhatsApp gerenciado no número da sua empresa."
>
  <script slot="head" is:inline type="application/ld+json" set:html={structuredData} />
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <Header />
  <main id="conteudo" class="canal-conteudo">
    <section class="canal-hero" aria-labelledby="canal-titulo">
      <div class="container canal-hero__grade">
        <div>
          <p class="rotulo">Canal WhatsApp gerenciado · Todo o Brasil</p>
          <h1 id="canal-titulo">Nenhum cliente sem resposta, nem fora do expediente.</h1>
          <p class="canal-lead">A Uno configura e opera o WhatsApp Business no número da sua empresa: perfil comercial, respostas de horário e histórico no CRM. O número continua sendo seu. Sua equipe só atende.</p>
          <div class="canal-acoes">
            <a class="btn btn--escuro" href="#contato">Pedir proposta do canal <svg class="seta" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <a class="btn btn--contorno" href={site.whatsapp} target="_blank" rel="noopener" data-contact-channel="whatsapp" data-cta-id="whatsapp_canal_hero" data-cta-position="canal_hero">Falar pelo WhatsApp</a>
          </div>
          <dl class="canal-fatos">
            <div><dt>Número</dt><dd>o da sua empresa, qualquer DDD</dd></div>
            <div><dt>Implantação</dt><dd>a partir de R$ {planos[0].implantacao}</dd></div>
            <div><dt>Mensalidade</dt><dd>a partir de R$ {planos[0].mensalidade}</dd></div>
          </dl>
        </div>

        <figure class="canal-mockup" aria-labelledby="canal-mockup-legenda">
          <div class="canal-mockup__telefone">
            <div class="canal-mockup__topo">
              <div class="canal-mockup__avatar" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="2"/></svg>
              </div>
              <div>
                <strong class="canal-mockup__nome">Sua Empresa · Atendimento</strong>
                <span class="canal-mockup__status">Perfil comercial · número da sua empresa</span>
              </div>
            </div>
            <div class="canal-mockup__mensagens">
              <div class="canal-balao canal-balao--cliente">
                <p>Olá! Gostaria de entender como funciona a consultoria e os horários disponíveis.</p>
                <time>19:42</time>
              </div>
              <div class="canal-balao canal-balao--bot">
                <span class="canal-balao__autor">Resposta de horário automática</span>
                <p>Olá! Agradecemos a mensagem. Nosso expediente é de segunda a sexta, das 9h às 18h. Seu contato já está registrado e nossa equipe retorna amanhã logo no início do dia.</p>
                <time>19:42 <svg width="14" height="10" viewBox="0 0 16 11" fill="none" aria-hidden="true"><path d="M1 5.5l3.5 3.5L11 1M5.5 9l3.5 1.5L15 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></time>
              </div>
            </div>
          </div>
          <div class="canal-mockup__crm">
            <span class="canal-mockup__crm-badge">CRM · registro automático</span>
            <ul class="canal-mockup__tags">
              <li><strong>Contato:</strong> Novo lead</li>
              <li><strong>Origem:</strong> Site (botão de WhatsApp)</li>
              <li><strong>Status:</strong> Aguardando a equipe</li>
            </ul>
          </div>
          <figcaption id="canal-mockup-legenda">Simulação: o cliente recebe resposta fora do horário, e sua equipe abre a conversa já sabendo a origem e o contexto.</figcaption>
        </figure>
      </div>
    </section>

    <section class="canal-bloco canal-bloco--linha" id="entrega" aria-labelledby="entrega-titulo">
      <div class="container">
        <p class="rotulo">Entrega</p>
        <h2 id="entrega-titulo">O que a Uno entrega</h2>
        <ul class="canal-entrega">
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="6" y="2.5" width="12" height="19" rx="2.5" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 18.5h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>Número da sua empresa</h3>
            <p>Uma linha que você já tem ou uma nova no CNPJ, com qualquer DDD. Sempre em seu nome.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="4.5" width="18" height="15" rx="2.5" stroke="currentColor" stroke-width="1.6"/><circle cx="9" cy="11" r="2.2" stroke="currentColor" stroke-width="1.6"/><path d="M5.8 16.5c.6-1.6 1.8-2.4 3.2-2.4s2.6.8 3.2 2.4M14.5 10h3.5M14.5 13.5h2.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>Perfil comercial completo</h3>
            <p>Foto, descrição da atividade, site e horário de atendimento configurados.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <h3>Respostas de horário</h3>
            <p>Saudação e aviso de ausência fora do expediente. Sem robô engessado.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6.5h16M4 12h16M4 17.5h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>CRM com histórico</h3>
            <p>Cada conversa ligada ao contato, com etiquetas para retomar o contexto.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="1" fill="currentColor"/></svg>
            <h3>Origem de cada contato</h3>
            <p>Os botões de WhatsApp do seu site passam a mostrar de onde veio cada cliente.</p>
          </li>
          <li>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M21 20H3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <h3>Relatório semanal</h3>
            <p>Contatos novos, origem e conversas que esquentaram. No plano Equipe.</p>
          </li>
        </ul>
      </div>
    </section>

    <section class="canal-bloco" aria-labelledby="passos-titulo">
      <div class="container">
        <p class="rotulo">Como funciona</p>
        <h2 id="passos-titulo">Da contratação ao canal funcionando em 3 passos.</h2>
        <ol class="canal-passos">
          <li class="canal-passo">
            <span class="canal-passo__num" aria-hidden="true">01</span>
            <h3>Alinhamento</h3>
            <p>Definimos o número, o perfil da empresa, o horário de expediente e o tom das mensagens de saudação e ausência.</p>
          </li>
          <li class="canal-passo">
            <span class="canal-passo__num" aria-hidden="true">02</span>
            <h3>Ativação pela Uno</h3>
            <p>Conectamos o número à API oficial do WhatsApp, completamos o perfil comercial e configuramos o CRM.</p>
          </li>
          <li class="canal-passo">
            <span class="canal-passo__num" aria-hidden="true">03</span>
            <h3>Sua equipe atende</h3>
            <p>Pelo navegador, pelo aplicativo do CRM ou pelo WhatsApp Business no celular. A Uno cuida da estrutura e dos relatórios.</p>
          </li>
        </ol>

        <div class="canal-divisao">
          <div>
            <h3>Sua parte</h3>
            <ul class="canal-itens">
              <li>Responder quando o contato já está quente.</li>
              <li>Aprovar o tom e os modelos de mensagem.</li>
              <li>Manter a linha ativa no nome da empresa.</li>
            </ul>
          </div>
          <div>
            <h3>Fora deste serviço</h3>
            <ul class="canal-itens">
              <li>A linha telefônica. Um plano básico de celular no CNPJ basta.</li>
              <li>Disparo em massa e plantão humano 24 horas.</li>
              <li>Anúncios pagos, que são um pacote à parte.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="canal-bloco canal-bloco--linha" aria-labelledby="publico-titulo">
      <div class="container">
        <p class="rotulo">Para quem</p>
        <h2 id="publico-titulo">Para empresas que atendem clientes pelo WhatsApp todos os dias.</h2>
        <div class="canal-publico">
          <div>
            <h3>Advocacia</h3>
            <p>Perfil e respostas informam área, horário e contato, dentro do que a OAB permite. Sem promessa de resultado.</p>
          </div>
          <div>
            <h3>Imobiliárias e corretores</h3>
            <p>Interesse em imóveis e visitas organizado, com a origem de cada contato e as conversas que pedem um corretor.</p>
          </div>
          <div>
            <h3>Clínicas e consultórios</h3>
            <p>Confirmações e orientações num número da clínica, não no celular dos profissionais. Histórico restrito à equipe, como pede a LGPD.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="canal-teste" aria-labelledby="teste-titulo">
      <div class="container">
        <div class="canal-teste__faixa">
          <div>
            <h2 id="teste-titulo">Teste antes de contratar.</h2>
            <p>Mande uma mensagem para o WhatsApp da Uno fora do horário comercial e veja a resposta de horário funcionando, como ela fica para os seus clientes.</p>
          </div>
          <a class="btn btn--contorno" href={site.whatsapp} target="_blank" rel="noopener" data-contact-channel="whatsapp" data-cta-id="whatsapp_canal_teste" data-cta-position="canal_teste">Testar no WhatsApp</a>
        </div>
      </div>
    </section>

    <section class="canal-preco" aria-labelledby="preco-titulo">
      <div class="container">
        <div class="canal-preco__cartao escuro">
          <div class="canal-preco__cab">
            <p class="rotulo">Investimento</p>
            <h2 id="preco-titulo">Dois planos, sem letra miúda.</h2>
            <p>Implantação única e mensalidade fixa.</p>
          </div>
          <div class="canal-planos">
            <article class="canal-plano">
              <h3>Essencial</h3>
              <p class="canal-plano__para">Para quem atende sozinho ou com uma pessoa de apoio.</p>
              <p class="canal-preco__valor"><small>R$</small> <strong>{planos[0].mensalidade}</strong> <span>por mês</span></p>
              <p class="canal-preco__de">Implantação única de R$ {planos[0].implantacao}</p>
              <ul class="canal-itens">
                <li>Até 2 atendentes</li>
                <li>Perfil do WhatsApp Business completo</li>
                <li>Respostas de horário e ausência</li>
                <li>CRM com histórico e etiquetas</li>
              </ul>
              <a class="btn canal-plano__btn" href="#contato" data-plano="essencial">Escolher o Essencial</a>
            </article>
            <article class="canal-plano canal-plano--destaque">
              <p class="canal-plano__selo">Recomendado para equipes</p>
              <h3>Equipe</h3>
              <p class="canal-plano__para">Para escritórios e clínicas com recepção ou time comercial.</p>
              <p class="canal-preco__valor"><small>R$</small> <strong>{planos[1].mensalidade}</strong> <span>por mês</span></p>
              <p class="canal-preco__de">Implantação única de R$ {planos[1].implantacao}</p>
              <ul class="canal-itens">
                <li>Até 4 atendentes ao mesmo tempo</li>
                <li>Tudo do plano Essencial</li>
                <li>Relatório semanal de contatos e origem</li>
                <li>Revisão mensal das mensagens</li>
              </ul>
              <a class="btn btn--uno-mint canal-plano__btn" href="#contato" data-plano="equipe">Escolher o Equipe <svg class="seta" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            </article>
          </div>
          <ul class="canal-garantias">
            <li>Sem fidelidade nem multa</li>
            <li>Ativação em até 3 dias úteis com a linha disponível</li>
            <li>O número é sempre da sua empresa</li>
          </ul>
          <p class="canal-preco__nota">A linha telefônica fica no nome da sua empresa e não entra na mensalidade. Responder clientes é gratuito. Só as mensagens que a empresa inicia depois de 24 horas sem contato têm custo da Meta, de centavos por mensagem, cobrado direto na conta da sua empresa.</p>
        </div>
      </div>
    </section>

    <section class="duvidas" id="duvidas" aria-labelledby="duvidas-titulo">
      <div class="container duvidas__grade">
        <div class="duvidas__cab">
          <p class="rotulo">Dúvidas</p>
          <h2 class="titulo-medio" id="duvidas-titulo">Perguntas sobre o canal.</h2>
          <p class="texto-apoio canal-duvidas__apoio">Tem outra dúvida específica? <a href="#contato">Fale com a gente logo abaixo</a>.</p>
        </div>
        <div class="faq">
          <details open><summary>Preciso de um número novo?</summary><p>Não necessariamente. Podemos usar uma linha que a empresa já tenha. Se hoje ela é o seu WhatsApp pessoal, recomendamos separar: uma linha nova no CNPJ, em qualquer operadora, custa pouco, e orientamos a contratação.</p></details>
          <details><summary>O DDD do número faz diferença?</summary><p>Não. O WhatsApp funciona igual com qualquer DDD, e atendemos empresas de todo o Brasil. O que passa confiança é um perfil completo, com nome, foto, descrição, site e horário de atendimento. Se o seu público é de uma cidade só, um número da região pode ajudar; a escolha é sua.</p></details>
          <details><summary>Se eu cancelar, fico com o número?</summary><p>Sim. A linha e a conta do WhatsApp Business ficam sempre em nome da sua empresa. No cancelamento, removemos nossos acessos e você continua com o número e a conta.</p></details>
          <details><summary>Posso continuar usando o WhatsApp Business no celular?</summary><p>Sim. A conexão com a API oficial pode manter o aplicativo no celular, e as conversas aparecem no app e no CRM. Confirmamos essa opção para o seu número no alinhamento.</p></details>
          <details><summary>O número corre risco de bloqueio?</summary><p>Usamos somente a API oficial da Meta, sem ferramentas que imitam o WhatsApp Web. Bloqueios acontecem com disparo em massa e mensagens não solicitadas, que não fazem parte deste serviço.</p></details>
          <details><summary>Eu perco meu WhatsApp pessoal?</summary><p>Não. O canal empresarial é uma conta e um número separados. Sua vida pessoal e sua empresa não se misturam.</p></details>
          <details><summary>Mais de uma pessoa pode atender ao mesmo tempo?</summary><p>Sim. O plano Essencial comporta até 2 atendentes e o plano Equipe até 4, cada um no próprio computador ou celular.</p></details>
          <details><summary>Existe fidelidade ou multa de cancelamento?</summary><p>Não. Você mantém o serviço enquanto fizer sentido para o seu negócio. A implantação é cobrada uma única vez.</p></details>
        </div>
      </div>
    </section>

    <Contato
      titulo="Vamos estruturar o WhatsApp da sua empresa."
      subtitulo="Envie os dados do seu negócio para receber uma proposta do canal gerenciado no número da sua empresa."
      servicoPadrao="whatsapp"
      variante="whatsapp"
    />
  </main>
  <Footer />
</BaseLayout>
<script>
  import '../../scripts/interno';
  import { iniciarFormulario } from '../../scripts/formulario';
  iniciarFormulario();
</script>
<style>
  .canal-hero {
    padding: clamp(40px, 6vw, 80px) 0 clamp(48px, 6vw, 80px);
    background-image:
      linear-gradient(rgba(16, 32, 28, .045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(16, 32, 28, .045) 1px, transparent 1px);
    background-size: 80px 80px;
  }
  .canal-hero__grade { display: grid; gap: 48px; align-items: center; }
  @media (min-width: 1000px) {
    .canal-hero__grade { grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 64px; }
  }
  h1 {
    font-size: clamp(38px, 4.6vw, 62px);
    line-height: 1.03;
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--uno-pine);
    text-wrap: balance;
  }
  .canal-lead {
    max-width: 40rem;
    margin-top: 24px;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.55;
    color: var(--uno-ink-2);
    text-wrap: pretty;
  }
  .canal-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 16px;
    margin-top: 32px;
  }
  .canal-fatos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 40px;
  }
  .canal-fatos > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 18px;
    border-left: 1px solid rgba(16, 32, 28, .15);
  }
  .canal-fatos > div:first-child { padding-left: 0; border-left: 0; }
  .canal-fatos dt { font-size: 16px; font-weight: 600; color: var(--uno-pine); }
  .canal-fatos dd { font-size: 15px; color: var(--uno-ink-2); }

  .canal-mockup { margin: 0; display: flex; flex-direction: column; }
  .canal-mockup__telefone {
    background: #EBF2EC;
    border-radius: var(--uno-radius-lg);
    padding: 18px;
    border: 1px solid rgba(16, 32, 28, .08);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .canal-mockup__topo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(16, 32, 28, .08);
  }
  .canal-mockup__avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--uno-pine);
    color: var(--uno-mint);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .canal-mockup__nome { display: block; font-size: 14px; font-weight: 600; color: var(--uno-pine); line-height: 1.2; }
  .canal-mockup__status { display: block; font-size: 12px; color: var(--uno-ink-2); margin-top: 2px; }
  .canal-mockup__mensagens { display: flex; flex-direction: column; gap: 12px; padding-bottom: 36px; }
  .canal-balao {
    max-width: 88%;
    padding: 12px 14px;
    border-radius: 12px;
    font-size: 14px;
    line-height: 1.45;
    box-shadow: 0 1px 3px rgba(0, 0, 0, .06);
  }
  .canal-balao p { margin: 0; font-size: 13.5px; }
  .canal-balao time {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    font-size: 11px;
    margin-top: 4px;
    color: var(--uno-ink-2);
  }
  .canal-balao--cliente { align-self: flex-start; background: var(--uno-white); color: var(--uno-ink); border-bottom-left-radius: 2px; }
  .canal-balao--bot { align-self: flex-end; background: #DCF8C6; color: var(--uno-ink); border-bottom-right-radius: 2px; }
  .canal-balao__autor {
    display: block;
    font-size: 11px;
    font-weight: 600;
    color: var(--uno-pine-2);
    margin-bottom: 4px;
    text-transform: uppercase;
    letter-spacing: .02em;
  }
  .canal-mockup__crm {
    position: relative;
    width: min(100% - 24px, 340px);
    margin: -40px 12px 0 auto;
    padding: 16px;
    border-radius: var(--uno-radius-md);
    background: var(--uno-white);
    border: 1px solid var(--uno-line);
    box-shadow: 0 18px 48px rgba(18, 54, 45, .12);
  }
  .canal-mockup__crm-badge {
    display: inline-flex;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(14, 43, 36, .08);
    font-size: 12px;
    font-weight: 600;
