---
import { readFile } from 'node:fs/promises';
import { existsSync } from 'node:fs';
import { publicDir } from 'astro:config/server';
import { imageMetadata } from 'astro/assets/utils';
import { authors } from '../../data/authors';
import { articlePath, type BlogArticle } from '../../lib/blog';
import { formatEditorialDate, utcCalendarDay } from '../../lib/editorial';
interface Props { article: BlogArticle; category: string; priority?: boolean }
const { article, category, priority = false } = Astro.props;
const { data } = article;
const dimensions = await imageMetadata(await readFile(new URL(`.${data.cover}`, publicDir)), data.cover);
const smallCover = data.cover.replace(/\.webp$/, '-768.webp');
const hasSmallCover = smallCover !== data.cover && existsSync(new URL(`.${smallCover}`, publicDir));
const titleId = `blog-${article.id.replaceAll('/', '-')}`;
---
<article class="blog-card" data-blog-article data-blog-category={category}>
  <a class="blog-card__link" href={articlePath(article.id)} aria-labelledby={titleId}>
    <div class="blog-card__image">
      <img src={data.cover} srcset={hasSmallCover ? `${smallCover} 768w, ${data.cover} ${dimensions.width}w` : undefined}
        sizes="(max-width: 600px) calc(100vw - 40px), (max-width: 1280px) 46vw, 604px"
        width={dimensions.width} height={dimensions.height} alt={data.coverAlt}
        loading={priority ? 'eager' : 'lazy'} decoding="async" />
    </div>
    <div class="blog-card__body">
      <h2 class="blog-card__title" id={titleId}>{data.title}</h2>
      <p class="blog-card__description">{data.description}</p>
      <p class="blog-card__meta">
        <span>{data.tags[0]}</span>
        {data.draft ? <span>Em revisão editorial</span> : data.author && data.pubDate && <span>Por {authors[data.author].name} · <time datetime={utcCalendarDay(data.pubDate)}>{formatEditorialDate(data.pubDate)}</time></span>}
      </p>
      <span class="blog-card__read">Ler artigo<svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
    </div>
  </a>
</article>
<style>
  .blog-card { min-width: 0; }
  .blog-card__link { display: flex; flex-direction: column; height: 100%; color: var(--uno-pine); text-decoration: none; border-radius: var(--uno-radius-sm); }
  .blog-card__image { overflow: hidden; border-radius: var(--uno-radius-sm); background: var(--uno-sage-2); }
  .blog-card__image img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  .blog-card__body { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding-top: 22px; }
  .blog-card__title { font-size: clamp(23px, 2vw, 28px); font-weight: 600; line-height: 1.22; letter-spacing: -.025em; text-wrap: pretty; }
  .blog-card__description { margin-top: 14px; font-size: 16px; line-height: 1.6; color: var(--uno-ink-2); }
  .blog-card__meta { display: flex; flex-wrap: wrap; gap: 4px 14px; margin-block: 18px 22px; font-size: 12px; line-height: 1.6; color: var(--uno-ink-2); }
  .blog-card__meta > span:first-child { font-weight: 600; }
  .blog-card__read { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-top: auto; font-size: 15px; font-weight: 600; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .blog-card__link:hover .blog-card__title { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .blog-card__link:focus-visible { outline-offset: 8px; }
  @media (max-width: 600px) {
    .blog-card__title { font-size: 25px; }
    .blog-card__body { padding-top: 20px; }
  }
</style>
