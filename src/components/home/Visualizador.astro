<dialog id="visualizador" aria-labelledby="visualizador-titulo" aria-describedby="visualizador-aviso">
  <div class="visualizador__cab"><div><p class="rotulo">Estudo conceitual</p><h2 id="visualizador-titulo"></h2></div><button type="button" class="btn btn--contorno" data-fechar>Fechar <span aria-hidden="true">×</span></button></div>
  <p id="visualizador-aviso">Esta é uma composição ilustrativa. Menus, agenda e botões da maquete não executam serviços.</p>
  <div class="visualizador__opcoes" aria-label="Formato do estudo"><button class="btn btn--escuro" type="button" data-formato="desk" aria-pressed="true">Desktop</button><button class="btn btn--contorno" type="button" data-formato="mob" aria-pressed="false">Celular</button></div>
  <div class="visualizador__rolagem" tabindex="0" aria-label="Composição ampliada, use as setas para rolar"><div class="visualizador__canvas" inert aria-hidden="true"></div></div>
  <div class="visualizador__leitura"><h3>Por que essa direção</h3><p data-decisao></p></div>
</dialog>
