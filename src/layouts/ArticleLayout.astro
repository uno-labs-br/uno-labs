---
import BaseLayout from './BaseLayout.astro';
import ArticleHeader from '../components/blog/ArticleHeader.astro';
import ArticleBody from '../components/blog/ArticleBody.astro';
import BackToSite from '../components/blog/BackToSite.astro';
import { authors } from '../data/authors.ts';
import { canonicalURL, site } from '../data/site.ts';
import { articlePath, type BlogArticle } from '../lib/blog.ts';

interface Props { article: BlogArticle }
const { article } = Astro.props;
const { data } = article;
const path = articlePath(article.id);
const author = data.author ? authors[data.author] : undefined;
const structuredData = !data.draft && author && data.pubDate ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': canonicalURL(path),
  mainEntityOfPage: canonicalURL(path),
  headline: data.title,
  description: data.description,
  image: canonicalURL(data.cover),
  datePublished: data.pubDate.toISOString(),
  ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString() } : {}),
  author: { '@type': 'Person', name: author.name },
  publisher: { '@type': 'Organization', name: site.name, url: site.origin },
}).replace(/</g, '\\u003c').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029') : undefined;
---
<BaseLayout title={`${data.title} — ${site.name}`} description={data.description} path={path} image={data.cover} imageAlt={data.coverAlt} article={!data.draft} noindex={data.draft ? true : undefined}>
  <Fragment slot="head">
    {!data.draft && author && <meta name="author" content={author.name} />}
    {!data.draft && data.pubDate && <meta property="article:published_time" content={data.pubDate.toISOString()} />}
    {!data.draft && data.updatedDate && <meta property="article:modified_time" content={data.updatedDate.toISOString()} />}
    {!data.draft && data.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    {structuredData && <script type="application/ld+json" is:inline set:html={structuredData} />}
  </Fragment>
  <a class="pular" href="#conteudo">Pular para o conteúdo</a>
  <nav class="article-navigation container" aria-label="Navegação do artigo">
    <a href="/" aria-label="UNO Labs — página inicial">UNO Labs</a>
    <div class="article-navigation__actions">
      <BackToSite />
      <a class="link-sublinhado" href="/blog/">Voltar para o blog</a>
    </div>
  </nav>
  <main id="conteudo" class="article-main">
    <article>
      <ArticleHeader data={data} />
      <ArticleBody><slot /></ArticleBody>
    </article>
  </main>
  <footer class="article-footer"><a href="/blog/">Voltar para o blog</a></footer>
</BaseLayout>
<style>
  .article-navigation { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; padding-block: 28px; border-bottom: 1px solid var(--uno-line); }
  .article-navigation > a:first-child { font-size: 24px; font-weight: 600; text-decoration: none; }
  .article-navigation__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  .article-main { width: min(800px, calc(100% - 40px)); margin-inline: auto; padding-block: clamp(40px, 6vw, 80px); }
  .article-footer { width: min(800px, calc(100% - 40px)); margin-inline: auto; padding-block: 24px 48px; border-top: 1px solid var(--uno-line); }
</style>
